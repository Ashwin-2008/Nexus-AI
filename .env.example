# ─────────────────────────────────────────────────────────────────────────────
# NEXUS AI deployment environment — copy to `.env` (repo root) and fill in.
#
# Target stack:
#   Supabase      → PostgreSQL database + document (object) storage
#   Render        → FastAPI API service + Celery worker
#   Vercel        → React/Vite frontend
#   Grafana Cloud → metrics, dashboards and alerts
#   Upstash       → Redis (Celery broker/result backend + health signal)
#   Qdrant        → vector index (Qdrant Cloud or a self-hosted instance)
#
# Variables marked [required] make `docker compose` fail fast when missing.
# See docs/DEPLOYMENT.md for the full walkthrough.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required secrets ─────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=
# Only needed when you run the optional local monitoring containers.
GRAFANA_PASSWORD=

# ── Supabase: PostgreSQL ─────────────────────────────────────────────────────
# Supabase → Connect → "Session pooler", switch the driver to psycopg and keep
# ?sslmode=require. URL-encode special characters in the password (@ → %40).
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Local containerised postgres (dev override only — the production compose file
# disables the service):
# POSTGRES_PASSWORD=<generate>
# POSTGRES_DB=nexus
# POSTGRES_USER=nexus

# ── Supabase: Storage (documents) ────────────────────────────────────────────
# Supabase → Project Settings → API → service_role key. This key bypasses RLS;
# it is backend-only and must never be shipped to the browser.
# The bucket is created automatically on first upload if it does not exist.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_STORAGE_BUCKET=nexus-documents
# auto | supabase | minio | local  (auto = supabase → minio → local)
STORAGE_BACKEND=supabase

# Optional self-hosted MinIO / S3-compatible storage (STORAGE_BACKEND=minio):
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=<generate>
# MINIO_SECRET_KEY=<generate>
# MINIO_BUCKET=nexus-documents

# ── Redis: Upstash ───────────────────────────────────────────────────────────
# Use the **Redis (RESP)** endpoint — NOT the REST URL/token. This backend
# speaks the Redis wire protocol (redis-py + Celery), not Upstash's HTTP API.
REDIS_URL=rediss://default:<redis-password>@<your-db>.upstash.io:6379
# Local dev container (dev override only):
# REDIS_URL=redis://:<password>@localhost:6379/0
# REDIS_PASSWORD=<generate>

# ── Vector index: Qdrant (Qdrant Cloud or self-hosted) ──────────────────────
# docker-compose runs Qdrant locally. On Render, point this at Qdrant Cloud:
# QDRANT_URL=https://<cluster-id>.<region>.cloud.qdrant.io:6333
# QDRANT_API_KEY=<qdrant-api-key>
# QDRANT_COLLECTION=nexus_chunks

# ── LLM provider ─────────────────────────────────────────────────────────────
# Groq serves an OpenAI-compatible chat API (free key at console.groq.com).
OPENAI_API_KEY=gsk_your_groq_key_here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
LLM_PROVIDER=openai_compatible
LLM_MODEL=llama-3.3-70b-versatile

# ── Embeddings ───────────────────────────────────────────────────────────────
# Groq does NOT expose an embeddings endpoint, so keep `hashing` (non-semantic,
# machinery verification) or configure a dedicated embeddings provider / `local`.
EMBEDDING_PROVIDER=hashing
EMBEDDING_DIMENSIONS=256
VECTOR_INDEX_BACKEND=qdrant

# ── API / CORS ───────────────────────────────────────────────────────────────
# Must include the Vercel production URL and preview domains you use.
# ALLOWED_ORIGINS=https://nexus-ai.vercel.app
# ENVIRONMENT=production
# JWT_EXPIRE_MINUTES=60
# LOG_LEVEL=INFO
# WORKER_CONCURRENCY=4
# CHUNK_SIZE=900
# CHUNK_OVERLAP=150
# HTTP_PORT=80
