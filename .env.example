# ─────────────────────────────────────────────────────────────────────────────
# Nexus AI – Environment Configuration
# Copy this file to .env and fill in all required values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=change_me_strong_password

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change_me_redis_password

# ── MinIO (S3-compatible object storage) ─────────────────────────────────────
MINIO_ACCESS_KEY=change_me_minio_access_key
MINIO_SECRET_KEY=change_me_minio_secret_key
MINIO_BUCKET=nexus-documents

# ── JWT Authentication ────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=change_me_generate_with_openssl_rand_hex_32
JWT_EXPIRE_MINUTES=60

# ── LLM Provider ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost,http://localhost:3000

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=change_me_grafana_password

# ── Application ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
WORKER_CONCURRENCY=4

# ── Networking ────────────────────────────────────────────────────────────────
# Port exposed by Nginx on the host
HTTP_PORT=80
