# ─────────────────────────────────────────────────────────────────────────────
# NEXUS AI deployment environment — copy to `.env` (repo root) and fill in.
# Required variables fail fast: docker compose will refuse to start without them.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required secrets ─────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32   (24+ chars for DB/Redis/MinIO)
POSTGRES_PASSWORD=
REDIS_PASSWORD=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
JWT_SECRET=
GRAFANA_PASSWORD=

# ── Database / infra names (defaults are fine) ───────────────────────────────
# POSTGRES_DB=nexus
# POSTGRES_USER=nexus
# MINIO_BUCKET=nexus-documents
# HTTP_PORT=80

# ── LLM provider ─────────────────────────────────────────────────────────────
# Groq serves an OpenAI-compatible chat API. Set the key you get from
# https://console.groq.com — the "openai_base_url" points the client at Groq.
OPENAI_API_KEY=gsk_your_groq_key_here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
LLM_PROVIDER=openai_compatible
LLM_MODEL=llama-3.3-70b-versatile

# ── Embeddings ───────────────────────────────────────────────────────────────
# IMPORTANT: Groq does NOT expose an embeddings endpoint, so the embeddings
# provider must NOT be openai_compatible while OPENAI_BASE_URL points at Groq.
# Keep `hashing` (non-semantic, works everywhere) or use a dedicated embeddings
# provider (OpenAI/other) via a separate deployment, or `local`
# (requirements-embeddings.txt + a CPU-heavy container).
EMBEDDING_PROVIDER=hashing
EMBEDDING_DIMENSIONS=256
VECTOR_INDEX_BACKEND=qdrant

# ── General ──────────────────────────────────────────────────────────────────
# ALLOWED_ORIGINS=https://your-domain.example
# ENVIRONMENT=production
# JWT_EXPIRE_MINUTES=60
# LOG_LEVEL=INFO
# WORKER_CONCURRENCY=4
# CHUNK_SIZE=900
# CHUNK_OVERLAP=150
